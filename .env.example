# Copy this file to .env and adjust values as needed

# LLM configuration
LLM_ENABLED=true
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.8:latest
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60.0
LLM_MAX_TOKENS=2048

# Optional: if you want to use a different database path
# DB_PATH=customer_support.db
